// examples/0/src/main.modest

include "libc/ctypes64"
include "libc/stdio"

var f32: Float32 = 0.0
var f64: Float64 = 0.0

var fx32: Fixed32 = 0.0
var fx64: Fixed64 = 0.0

const c = 1.5

func main () -> Int {
	printf("Hello World!\n")

	f32 = 1.0
	f64 = 1.0

	fx32 = 1
	fx64 = 1

	printf("fx32 = 0x%08x\n", fx32)
	printf("fx64 = 0x%016llx\n", fx64)

	fx32 = c
	fx64 = c

	printf("fx32 = 0x%08x\n", fx32)
	printf("fx64 = 0x%016llx\n", fx64)

	return 0
}

