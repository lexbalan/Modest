import "builtin"
include "ctypes64"
include "math"
include "stdlib"
include "stdio"

include "libc/ctypes64"
include "libc/math"
include "libc/stdlib"
include "libc/stdio"


type Point = {
	x: Double
	y: Double
}

type Line = {
	a: Point
	b: Point
}


var line: Line = {
	a = {x = 0, y = 0}
	b = {x = 1.0, y = 1.0}
}



@inline
func max (a: Double, b: Double) -> Double {
	if a > b {
		return a
	}
	return b
}


@inline
func min (a: Double, b: Double) -> Double {
	if a < b {
		return a
	}
	return b
}


// Pythagorean theorem
func distance (a: Point, b: Point) -> Double {
	let dx: Double = max(a.x, b.x) - min(a.x, b.x)
	let dy: Double = max(a.y, b.y) - min(a.y, b.y)
	let dx2: Double = pow(dx, 2)
	let dy2: Double = pow(dy, 2)
	return sqrt(dx2 + dy2)
}


func lineLength (line: Line) -> Double {
	return distance(line.a, line.b)
}


func ptr_example () -> Unit {
	let ptr_p = *Point malloc(sizeof(Point))
	ptr_p.x = 10
	ptr_p.y = 20

	printf("point(%f, %f)\n", ptr_p.x, ptr_p.y)
}


@nonstatic
func main () -> Int {
	let len: Double = lineLength(line)
	printf("line length = %f\n", len)

	ptr_example()

	return 0
}

