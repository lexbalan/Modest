import "builtin"
include "ctypes64"
include "stdio"

include "libc/ctypes64"
include "libc/stdio"


type Exact = {tag: Word8, len: Nat32}
type Packed = @layout("packed") Exact


func makePacked () -> Packed {
	printf("called\n")
	return {tag = 1, len = 2}
}


@nonstatic
func main () -> Int {
	printf("Hello World!\n")

	var e = Exact makePacked()
	printf("%x %u\n", Nat32 e.tag, e.len)

	return 0
}

