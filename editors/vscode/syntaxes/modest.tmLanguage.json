{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Modest",
	"scopeName": "source.modest",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#chars" },
		{ "include": "#attributes" },
		{ "include": "#directives" },
		{ "include": "#tags" },
		{ "include": "#numbers" },
		{ "include": "#function-definition" },
		{ "include": "#keywords" },
		{ "include": "#constants" },
		{ "include": "#builtins" },
		{ "include": "#types" },
		{ "include": "#function-call" },
		{ "include": "#operators" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.modest",
					"begin": "//",
					"end": "$"
				},
				{
					"name": "comment.block.modest",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.modest",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.modest",
					"match": "\\\\."
				}
			]
		},
		"chars": {
			"name": "string.quoted.single.modest",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.modest",
					"match": "\\\\."
				}
			]
		},
		"attributes": {
			"name": "storage.modifier.attribute.modest",
			"match": "@[A-Za-z_][A-Za-z0-9_]*"
		},
		"directives": {
			"name": "keyword.control.directive.modest",
			"match": "\\$[A-Za-z_][A-Za-z0-9_]*"
		},
		"tags": {
			"name": "constant.other.tag.modest",
			"match": "#[A-Za-z_][A-Za-z0-9_]*"
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.modest",
					"match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b"
				},
				{
					"name": "constant.numeric.float.modest",
					"match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
				},
				{
					"name": "constant.numeric.integer.modest",
					"match": "\\b[0-9][0-9_]*\\b"
				}
			]
		},
		"function-definition": {
			"match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "storage.type.function.modest" },
				"2": { "name": "entity.name.function.modest" }
			}
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.modest",
					"match": "\\b(if|else|while|break|again|return)\\b"
				},
				{
					"name": "storage.type.modest",
					"match": "\\b(func|var|let|const|type|record|module)\\b"
				},
				{
					"name": "storage.modifier.modest",
					"match": "\\b(public|private|export|extern|unsafe)\\b"
				},
				{
					"name": "keyword.control.import.modest",
					"match": "\\b(import|include|as)\\b"
				},
				{
					"name": "keyword.other.modest",
					"match": "\\b(pragma|asm|new)\\b"
				},
				{
					"name": "keyword.operator.logical.modest",
					"match": "\\b(and|or|not)\\b"
				}
			]
		},
		"constants": {
			"name": "constant.language.modest",
			"match": "\\b(true|false|nil)\\b"
		},
		"builtins": {
			"name": "support.function.builtin.modest",
			"match": "\\b(sizeof|alignof|lengthof|offsetof|__va_arg|__va_start|__va_end|__va_copy|__defined|__compiler|__target)\\b"
		},
		"types": {
			"name": "entity.name.type.modest",
			"match": "\\b_*[A-Z][A-Za-z0-9_]*\\b"
		},
		"function-call": {
			"match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
			"captures": {
				"1": { "name": "entity.name.function.call.modest" }
			}
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.modest",
					"match": "(<<=|>>=|\\+=|-=|\\*=|/=|%=|=(?![=>]))"
				},
				{
					"name": "keyword.operator.comparison.modest",
					"match": "(==|!=|<=|>=|<(?![<-])|>(?!>))"
				},
				{
					"name": "keyword.operator.arrow.modest",
					"match": "(->|=>|<-)"
				},
				{
					"name": "keyword.operator.bitwise.modest",
					"match": "(<<|>>|&(?!&)|\\|(?!\\|)|\\^|~)"
				},
				{
					"name": "keyword.operator.arithmetic.modest",
					"match": "(\\+\\+|--|\\+|-|\\*|/|%)"
				}
			]
		}
	}
}
