// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: fold remainder
// EXPECTED-FAIL(llvm): BUGS.md#32 the fold of `%` is floored, run time truncates
//
// `%` is the remainder left by a division that truncates toward zero, so
// its sign follows the dividend: `-10 % 3` is `-1`, not `2`.  Both backends
// compute that at run time.  The compile-time fold uses Python's `%`
// instead, which floors, and the two disagree on every pair of operands
// whose signs differ.
//
// Each check computes the same remainder twice — once from constants the
// compiler folds, once from values it has to call a function to get — and
// requires them to be equal.  Under c11 they agree by accident: that
// backend re-emits the operands as C source text and lets C redo the
// arithmetic (BUGS.md #10), so the fold never reaches the program.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


const ten: Int32 = 10
const three: Int32 = 3
const negTen: Int32 = -10
const negThree: Int32 = -3


func opaque (n: Int32) -> Int32 {
	return n
}


func check (name: *ConstCharStr, folded: Int32, computed: Int32) -> Bool {
	if folded == computed {
		return true
	}
	printf("%s: folded %d, computed %d\n", name, folded, computed)
	return false
}


func main () -> Int {
	var a = opaque(10)
	var b = opaque(3)
	var negA = opaque(-10)
	var negB = opaque(-3)

	var ok = true

	// Both operands positive: the two definitions of `%` agree here, so
	// this pair is the control and must pass everywhere.
	ok = check("10 % 3", ten % three, a % b) and ok

	// One operand negative: floored and truncated remainders differ.
	ok = check("-10 % 3", negTen % three, negA % b) and ok
	ok = check("10 % -3", ten % negThree, a % negB) and ok

	// Both negative: they agree again in sign but not in value.
	ok = check("-10 % -3", negTen % negThree, negA % negB) and ok

	// The identity that defines the remainder, folded and computed.
	ok = check("(-10 / 3) * 3 + -10 % 3",
		(negTen / three) * three + negTen % three, negA) and ok

	if not ok {
		printf("failed: fold remainder\n")
		return exitFailure
	}

	printf("passed: fold remainder\n")
	return exitSuccess
}
