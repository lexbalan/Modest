// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: scalar equality
// EXPECT-OUT: passed: record equality
// EXPECT-OUT: passed: record from a call
// EXPECT-OUT: passed: array equality
// EXPECT-OUT: passed: array from a call
// EXPECT-OUT: passed: pointer equality
// EXPECT-OUT: passed: ordering
// EXPECT-OUT: passed: ordering edges
// EXPECT-OUT: passed: comparison
//
// The two halves of comparison, which are not the same size.
//
// Equality is the wide one: `==` and `!=` work on any two values of the
// same type — every base type, records field by field, arrays element by
// element, pointers as addresses.  Ordering is the narrow one: `<` `>`
// `<=` `>=` need a type that carries a number, which is IntX, NatX and
// FloatX and nothing else.  `Word` is a bit pattern and `Char` is a code
// unit; neither is a quantity, and both are rejected at compile time with
// `unsuitable value type '...' for 'lt' operation` — so the ban itself
// cannot be written here, only its consequence: they still compare equal.
//
// Chained comparison is not a third half: `a < b < c` parses left to
// right, like every other level, and then fails on types — the `<` on the
// right has a Bool on its left and a number on its right.  All four
// ordering operators have to chain the same way, which is what `<` and `>`
// stopped doing when they were written with an `if` of their own instead
// of an `elif` (fixed 2026-08-28 in `expr_value_5`); the four mixed forms
// `a < b <= c` and friends went further and crashed the compiler with a
// self-referential TextInfo.  None of that is expressible here — a chain
// is a compile error either way, and the suite has no negative-compile
// mode.
//
// Where a composite is compared, the check is written so that the values
// differ in the *last* place they could — the last field, the last element,
// the innermost member.  A comparison that stops early passes a test that
// only ever differs in the first.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


type Point = {
	x: Int32
	y: Int32
}


type Segment = {
	from: Point
	to: Point
}


func testScalarEquality () -> Bool {
	var t = true
	var f = false
	if not (t == true) or not (f == false) or t == f or not (t != f) {
		printf("Bool equality is wrong\n")
		return false
	}

	var i: Int32 = 42
	var j: Int32 = 42
	if not (i == j) or i != j or i == 43 or not (i != 43) {
		printf("Int32 equality is wrong\n")
		return false
	}

	// A negative value equals itself and nothing near it.
	var neg: Int32 = -42
	if not (neg == -42) or neg == 42 {
		printf("Int32 -42 equality is wrong\n")
		return false
	}

	var n: Nat64 = 10_000_000_000
	if not (n == 10_000_000_000) or n == 10_000_000_001 {
		printf("Nat64 equality is wrong\n")
		return false
	}

	// Word has no ordering, but equality is exactly what it does have.
	var w: Word8 = 0xA5
	var v: Word8 = 0xA5
	if not (w == v) or w != 0xA5 or w == 0x5A {
		printf("Word8 equality is wrong\n")
		return false
	}

	var w64: Word64 = 0xDEADBEEFCAFEBABE
	if not (w64 == 0xDEADBEEFCAFEBABE) or w64 == 0xDEADBEEFCAFEBABF {
		printf("Word64 equality is wrong\n")
		return false
	}

	// And so does Char: same code unit, or not.
	var c: Char8 = 'x'
	if not (c == 'x') or c == 'y' or not (c != 'y') {
		printf("Char8 equality is wrong\n")
		return false
	}

	var d: Float64 = 0.5
	if not (d == 0.5) or d == 0.25 {
		printf("Float64 equality is wrong\n")
		return false
	}

	printf("passed: scalar equality\n")
	return true
}


// A record compares field by field, and nesting does not stop it: the
// difference below is as deep as this file goes.
// How many times `makePoint` has been entered — a returned record has to
// be compared exactly once, and this is the only way to see it.
var pointCalls: Int32 = 0


func makePoint () -> Point {
	pointCalls = pointCalls + 1
	return Point {x = 1, y = 2}
}


func makeOtherPoint () -> Point {
	return Point {x = 1, y = 3}
}


func testRecordEquality () -> Bool {
	var p: Point = {x = 1, y = 2}
	var q: Point = {x = 1, y = 2}

	if not (p == q) or p != q {
		printf("{1, 2} does not equal {1, 2}\n")
		return false
	}

	// A difference in the last field is enough — a comparison that only
	// looked at the first would pass everything above and fail here.
	var lastDiffers: Point = {x = 1, y = 3}
	if p == lastDiffers or not (p != lastDiffers) {
		printf("{1, 2} equals {1, 3}\n")
		return false
	}

	var firstDiffers: Point = {x = 0, y = 2}
	if p == firstDiffers {
		printf("{1, 2} equals {0, 2}\n")
		return false
	}

	// Nested: two segments differing only in the y of their second point.
	var s1: Segment = {from = {x = 1, y = 2}, to = {x = 3, y = 4}}
	var s2: Segment = {from = {x = 1, y = 2}, to = {x = 3, y = 4}}
	var s3: Segment = {from = {x = 1, y = 2}, to = {x = 3, y = 5}}

	if not (s1 == s2) or s1 == s3 {
		printf("nested record equality is wrong\n")
		return false
	}

	// A record whose fields have unequal widths has padding between them,
	// and comparing it is a bug of its own — see record_padding.modest.

	printf("passed: record equality\n")
	return true
}


// A record that comes back from a call is compared like any other value,
// but it is the one shape that has no storage of its own.  Comparing a
// record means comparing every byte of it, and that needs an address: the
// C backend calls memcmp, and in C the result of a call has no address at
// all.  So the backend has to put it somewhere — exactly once, because a
// call evaluated twice would be a different bug wearing the same result.
func testRecordFromCall () -> Bool {
	var p: Point = {x = 1, y = 2}

	// On the left.
	pointCalls = 0
	if not (makePoint() == p) or makePoint() != p {
		printf("a returned record does not equal the value it holds\n")
		return false
	}
	if pointCalls != 2 {
		printf("two calls on the left ran %d times, expected 2\n", pointCalls)
		return false
	}

	// On the right — the operand the backend reaches second.
	pointCalls = 0
	if not (p == makePoint()) or p != makePoint() {
		printf("a returned record does not equal the value it holds\n")
		return false
	}
	if pointCalls != 2 {
		printf("two calls on the right ran %d times, expected 2\n", pointCalls)
		return false
	}

	// Both sides at once: two results, neither of which has a name.
	pointCalls = 0
	if not (makePoint() == makePoint()) {
		printf("two equal returned records do not compare equal\n")
		return false
	}
	if pointCalls != 2 {
		printf("a call on each side ran %d times, expected 2\n", pointCalls)
		return false
	}

	// Against a literal, which is the other value with no storage.
	if not (makePoint() == Point {x = 1, y = 2}) {
		printf("a returned record does not equal an equal literal\n")
		return false
	}

	// And a difference in the last field is still seen through the call.
	if makePoint() == makeOtherPoint() or not (makePoint() != makeOtherPoint()) {
		printf("{1, 2} returned equals {1, 3} returned\n")
		return false
	}

	printf("passed: record from a call\n")
	return true
}


// An array compares element by element — which is what makes `==` the way
// to check a hash or a key, with no loop and no memcmp.
func testArrayEquality () -> Bool {
	var h1: [4]Word8 = [1, 2, 3, 4]
	var h2: [4]Word8 = [1, 2, 3, 4]

	if not (h1 == h2) or h1 != h2 {
		printf("equal arrays do not compare equal\n")
		return false
	}

	// Again the last position, for the same reason as above.
	var lastDiffers: [4]Word8 = [1, 2, 3, 5]
	if h1 == lastDiffers or not (h1 != lastDiffers) {
		printf("arrays differing in the last element compare equal\n")
		return false
	}

	var firstDiffers: [4]Word8 = [0, 2, 3, 4]
	if h1 == firstDiffers {
		printf("arrays differing in the first element compare equal\n")
		return false
	}

	// A longer array of a wider element type, differing in one place only.
	var k1: [8]Int32 = [10, 20, 30, 40, 50, 60, 70, 80]
	var k2: [8]Int32 = [10, 20, 30, 40, 50, 60, 70, 80]
	var k3: [8]Int32 = [10, 20, 30, 40, 50, 60, 70, 81]

	if not (k1 == k2) or k1 == k3 {
		printf("[8]Int32 equality is wrong\n")
		return false
	}

	// An array of records: both kinds of member-wise comparison at once.
	var ps1: [2]Point = [{x = 1, y = 2}, {x = 3, y = 4}]
	var ps2: [2]Point = [{x = 1, y = 2}, {x = 3, y = 4}]
	var ps3: [2]Point = [{x = 1, y = 2}, {x = 3, y = 5}]

	if not (ps1 == ps2) or ps1 == ps3 {
		printf("[2]Point equality is wrong\n")
		return false
	}

	// A two-dimensional array is an array of arrays, and compares as one.
	var m1: [2][2]Int32 = [[1, 2], [3, 4]]
	var m2: [2][2]Int32 = [[1, 2], [3, 4]]
	var m3: [2][2]Int32 = [[1, 2], [3, 5]]

	if not (m1 == m2) or m1 == m3 {
		printf("[2][2]Int32 equality is wrong\n")
		return false
	}

	printf("passed: array equality\n")
	return true
}


// How many times `makeHash` has been entered — the array counterpart of
// pointCalls above.
var hashCalls: Int32 = 0


func makeHash () -> [4]Word8 {
	hashCalls = hashCalls + 1
	return [1, 2, 3, 4]
}


// Differs from makeHash() in the last element and nowhere else.
func makeOtherHash () -> [4]Word8 {
	return [1, 2, 3, 5]
}


// An array from a call is the same story as a record from a call, one step
// further: C cannot return an array at all, so the result comes back
// through storage the caller lends the callee.  In a comparison there is no
// storage to lend — and, as with the record, the value must be fetched
// exactly once.
func testArrayFromCall () -> Bool {
	var h: [4]Word8 = [1, 2, 3, 4]

	// On the left.
	hashCalls = 0
	if not (makeHash() == h) or makeHash() != h {
		printf("a returned array does not equal the value it holds\n")
		return false
	}
	if hashCalls != 2 {
		printf("two calls on the left ran %d times, expected 2\n", hashCalls)
		return false
	}

	// On the right — the operand the backend reaches second.
	hashCalls = 0
	if not (h == makeHash()) or h != makeHash() {
		printf("a returned array does not equal the value it holds\n")
		return false
	}
	if hashCalls != 2 {
		printf("two calls on the right ran %d times, expected 2\n", hashCalls)
		return false
	}

	// Both sides at once: two results, neither of which has a name.
	hashCalls = 0
	if not (makeHash() == makeHash()) {
		printf("two equal returned arrays do not compare equal\n")
		return false
	}
	if hashCalls != 2 {
		printf("a call on each side ran %d times, expected 2\n", hashCalls)
		return false
	}

	// Against a literal, which is the other value with no storage.
	if not (makeHash() == [1, 2, 3, 4]) {
		printf("a returned array does not equal an equal literal\n")
		return false
	}

	// And a difference in the last element is still seen through the call.
	if makeHash() == makeOtherHash() or not (makeHash() != makeOtherHash()) {
		printf("[1, 2, 3, 4] returned equals [1, 2, 3, 5] returned\n")
		return false
	}

	printf("passed: array from a call\n")
	return true
}


// Pointers compare as addresses: what they point at is not looked at, and
// `nil` is just the address no object has.
func testPointerEquality () -> Bool {
	var p: Point = {x = 1, y = 2}
	var q: Point = {x = 1, y = 2}

	var ptr = &p
	var same = &p
	var other = &q
	var none: *Point = nil

	if not (ptr == same) or ptr != same {
		printf("two pointers to the same value are not equal\n")
		return false
	}

	// The values are equal, the addresses are not — this is the whole
	// difference between `*p == *q` and `p == q`.
	if ptr == other {
		printf("pointers to distinct but equal values compare equal\n")
		return false
	}

	if not (p == q) {
		printf("the pointed-at values were supposed to be equal\n")
		return false
	}

	if ptr == nil or not (ptr != nil) {
		printf("a pointer to a variable compares equal to nil\n")
		return false
	}

	if not (none == nil) or none != nil {
		printf("a nil pointer does not compare equal to nil\n")
		return false
	}

	// Pointers into an array: neighbouring elements have distinct
	// addresses, and the same element twice has one address.
	var arr: [4]Int32 = [10, 20, 30, 40]
	var first = &arr[0]
	var firstAgain = &arr[0]
	var second = &arr[1]

	if not (first == firstAgain) or first == second {
		printf("pointers into an array compare wrong\n")
		return false
	}

	printf("passed: pointer equality\n")
	return true
}


func testOrdering () -> Bool {
	var a: Int32 = 1
	var b: Int32 = 2
	var a2: Int32 = 1

	if not (a < b) or not (b > a) or b < a or a > b {
		printf("ordering of Int32 1 and 2 is wrong\n")
		return false
	}

	// On equal operands, `<=` and `>=` hold and the strict ones do not.
	if not (a <= a2) or not (a >= a2) or a < a2 or a > a2 {
		printf("ordering of two equal Int32 is wrong\n")
		return false
	}

	var n: Nat32 = 7
	var m: Nat32 = 9
	if not (n < m) or not (m >= n) or n >= m {
		printf("ordering of Nat32 7 and 9 is wrong\n")
		return false
	}

	var x: Float64 = 1.5
	var y: Float64 = 1.75
	if not (x < y) or not (y > x) or x >= y {
		printf("ordering of Float64 1.5 and 1.75 is wrong\n")
		return false
	}

	// A fraction between two whole values is ordered by the fraction —
	// the reason Float is ordered at all and not just compared.
	var one: Float64 = 1.0
	var two: Float64 = 2.0
	if not (one < x) or not (x < two) {
		printf("1.0 < 1.5 < 2.0 does not hold\n")
		return false
	}

	printf("passed: ordering\n")
	return true
}


// Ordering has to survive the places where a sign or a width could be lost
// on the way into the comparison.
func testOrderingEdges () -> Bool {
	// Negative against positive: an Int that is quietly read as a Nat
	// would come out the largest value there is instead of the smallest.
	var neg: Int32 = -1
	var zero: Int32 = 0
	var pos: Int32 = 1

	if not (neg < zero) or not (zero < pos) or not (neg < pos) {
		printf("-1 < 0 < 1 does not hold\n")
		return false
	}

	if neg > zero or neg >= zero {
		printf("-1 compares greater than 0\n")
		return false
	}

	// Two negatives are ordered by magnitude, reversed.
	var less: Int32 = -100
	if not (less < neg) or not (neg > less) {
		printf("-100 < -1 does not hold\n")
		return false
	}

	// The extremes of a narrow type, which is where a widening that
	// sign-extends the wrong way would show.
	var min8: Int8 = -128
	var max8: Int8 = 127
	if not (min8 < max8) or not (max8 > min8) or min8 >= max8 {
		printf("Int8 -128 < 127 does not hold\n")
		return false
	}

	// A Nat32 above the signed range: read as an Int32 this would be
	// negative, and would compare below 1 instead of above it.
	var big: Nat32 = 3_000_000_000
	var oneNat: Nat32 = 1
	if not (big > oneNat) or big < oneNat {
		printf("Nat32 3000000000 does not compare greater than 1\n")
		return false
	}

	// The same at 64 bits.
	var big64: Nat64 = 10_000_000_000_000_000_000
	var small64: Nat64 = 1
	if not (big64 > small64) {
		printf("Nat64 1e19 does not compare greater than 1\n")
		return false
	}

	// Ordering and equality agree: exactly one of <, ==, > holds.
	var p: Int32 = 5
	var q: Int32 = 7
	if (p < q) == (p == q) or (p < q) == (p > q) or p == q {
		printf("trichotomy of 5 and 7 is broken\n")
		return false
	}

	printf("passed: ordering edges\n")
	return true
}


func main () -> Int {
	var result = true
	result = testScalarEquality() and result
	result = testRecordEquality() and result
	result = testRecordFromCall() and result
	result = testArrayEquality() and result
	result = testArrayFromCall() and result
	result = testPointerEquality() and result
	result = testOrdering() and result
	result = testOrderingEdges() and result

	if not result {
		printf("failed: comparison\n")
		return exitFailure
	}

	printf("passed: comparison\n")
	return exitSuccess
}
