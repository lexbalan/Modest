// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: record padding
// EXPECTED-FAIL(llvm): BUGS.md#26 record equality compares the padding bytes
//
// docs/lang/value/binary.md says records compare field-wise.  Both backends
// instead compare the raw bytes of the whole object — `__builtin_memcmp` in
// C, a hand-written `memeq` loop in LLVM — and a record whose fields have
// unequal widths has padding between them that belongs to neither field.
//
// `Sample` below is one byte followed by a four-byte field, so on any
// ordinary target there are three bytes of padding after `tag`.  Two
// `Sample` values built from the same field values must be equal; whether
// they are depends on what the compiler happened to leave in those three
// bytes.
//
// Under c11 it currently passes, and not because the comparison is right:
// the C backend emits a compound literal, which clang zero-fills, so the
// padding agrees by accident.  Under llvm the record is an `alloca` with
// the fields stored into it, the padding keeps whatever the stack held, and
// two identical values compare unequal.  The test is marked failing there
// and passing here on purpose — the day the C backend stops emitting a
// compound literal, this file is what notices.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


// 1 byte, then 4 — three bytes of padding in between.
type Sample = {
	tag: Word8
	value: Int32
}


// Padding at the end rather than in the middle: 4 + 1, rounded up to 8.
type Tail = {
	value: Int32
	flag: Bool
}


func testMiddlePadding () -> Bool {
	var a: Sample = {tag = 0x01, value = 7}
	var b: Sample = {tag = 0x01, value = 7}

	if not (a == b) {
		printf("{0x01, 7} does not equal {0x01, 7}\n")
		return false
	}

	// Unequal values must still come out unequal — a comparison that is
	// wrong in one direction is usually wrong in the other.
	var differentTag: Sample = {tag = 0x02, value = 7}
	var differentValue: Sample = {tag = 0x01, value = 8}

	if a == differentTag or a == differentValue {
		printf("{0x01, 7} equals a record it differs from\n")
		return false
	}

	return true
}


func testTailPadding () -> Bool {
	var a: Tail = {value = 7, flag = true}
	var b: Tail = {value = 7, flag = true}
	var c: Tail = {value = 7, flag = false}

	if not (a == b) or a == c {
		printf("record with trailing padding compares wrong\n")
		return false
	}

	return true
}


// The same record inside an array and inside another record: whatever the
// padding does, it does it in every container.
func testNested () -> Bool {
	var s1: [2]Sample = [{tag = 0x01, value = 7}, {tag = 0x02, value = 8}]
	var s2: [2]Sample = [{tag = 0x01, value = 7}, {tag = 0x02, value = 8}]
	var s3: [2]Sample = [{tag = 0x01, value = 7}, {tag = 0x02, value = 9}]

	if not (s1 == s2) or s1 == s3 {
		printf("[2]Sample equality is wrong\n")
		return false
	}

	return true
}


func main () -> Int {
	var result = true
	result = testMiddlePadding() and result
	result = testTailPadding() and result
	result = testNested() and result

	if not result {
		printf("failed: record padding\n")
		return exitFailure
	}

	printf("passed: record padding\n")
	return exitSuccess
}
