// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: arithmetic levels
// EXPECT-OUT: passed: bitwise against equality
// EXPECT-OUT: passed: bitwise levels
// EXPECT-OUT: passed: shift levels
// EXPECT-OUT: passed: logical levels
// EXPECT-OUT: passed: unary and construction
// EXPECT-OUT: passed: precedence
//
// The ladder from docs/lang/value/README.md, checked from the loose end
// down: or, and, all the comparisons, then + - & | ^ << >>, then * / %,
// then construction, then the unary operators, then the postfix ones.
//
// Every check here is written without the parentheses it is about, and the
// expected value is one the other grouping would not produce — otherwise
// the check would pass under any precedence at all and prove nothing.
//
// Two things are not where a C habit puts them.  The bitwise operators bind
// *tighter* than `==`, so `w & mask == 0` needs no parentheses and means
// what it looks like; in C the same line is `w & (mask == 0)`.  And `&`,
// `|`, `^` and the shifts share one level with no order among them, so a
// chain that mixes two of them is refused rather than grouped — those cases
// live in reject_bitwise_mix.modest, and what is checked here is that a
// chain of one of them still works.  Every level is left-associative, so a
// chain meets one literal at a time — a literal pair on its own would not
// compile today (BUG#28).
//
// Precedence decides how an unparenthesised expression groups; what happens
// when the parentheses are written down is parens.modest.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


func testArithmeticLevels () -> Bool {
	var a: Int32 = 2
	var b: Int32 = 3
	var c: Int32 = 4

	// `*` `/` `%` before `+` `-`.
	if a + b * c != 14 or b * c + a != 14 {
		printf("2 + 3 * 4 = %d, 3 * 4 + 2 = %d, expected 14/14\n",
			a + b * c, b * c + a)
		return false
	}

	var twelve: Int32 = 12
	if twelve - twelve / c != 9 or twelve % b + c != 4 {
		printf("12 - 12 / 4 = %d, 12 %% 3 + 4 = %d, expected 9/4\n",
			twelve - twelve / c, twelve % b + c)
		return false
	}

	// Arithmetic before ordering, and ordering before equality-as-a-value.
	if not (a + b > c) or a * b < c {
		printf("2 + 3 > 4 or 2 * 3 < 4 is wrong\n")
		return false
	}

	printf("passed: arithmetic levels\n")
	return true
}


// The level that differs from C: `&`, `^` and `|` are tighter than `==`.
func testBitwiseAgainstEquality () -> Bool {
	var w: Word8 = 0x0F
	var mask: Word8 = 0xF0

	// (w & mask) == 0 — true.  As C would read it, w & (mask == 0), the
	// operand types alone would not even typecheck.
	if not (w & mask == 0) {
		printf("`w & mask == 0` did not group as (w & mask) == 0\n")
		return false
	}

	var overlapping: Word8 = 0x03
	if w & overlapping == 0 {
		printf("0x0F & 0x03 was seen as zero\n")
		return false
	}

	// The same for `|` and `^`, where the grouping is again visible in the
	// answer: (w | mask) == 0xFF, not w | (mask == 0xFF).
	if not (w | mask == 0xFF) or not (w ^ mask == 0xFF) {
		printf("`|` and `^` did not group tighter than `==`\n")
		return false
	}

	// And it holds through `!=` as well as `==`.
	if not (w & mask != 0xFF) {
		printf("`w & mask != 0xFF` did not group as (w & mask) != 0xFF\n")
		return false
	}

	printf("passed: bitwise against equality\n")
	return true
}


// Among themselves: one level with no order inside it.  A chain of one
// operator groups from the left like everything else; a chain of two
// different ones has no answer to group by and is refused, so the only
// thing that can be written unparenthesised is a single-operator chain.
func testBitwiseLevels () -> Bool {
	var a: Word8 = 0x01
	var b: Word8 = 0x06
	var c: Word8 = 0x02
	var s: Word8 = 0x33

	// Left to right, and the reason it matters: right-associative, the two
	// literals would meet each other first and a literal pair does not
	// compile (BUG#28).  (0x33 ^ 0x0F) ^ 0x30 = 0x3C ^ 0x30 = 0x0C.
	if s ^ 0x0F ^ 0x30 != 0x0C {
		printf("0x33 ^ 0x0F ^ 0x30 = 0x%02x, expected 0x0C\n",
			Word32(s ^ 0x0F ^ 0x30))
		return false
	}

	// The same for the other two, where the answer does not depend on the
	// grouping but the chain still has to be accepted.
	if a | b | c != 0x07 or a & b & c != 0x00 {
		printf("0x01 | 0x06 | 0x02 = 0x%02x, 0x01 & 0x06 & 0x02 = 0x%02x\n",
			Word32(a | b | c), Word32(a & b & c))
		return false
	}

	// Mixing needs parentheses, and then they decide: the two groupings of
	// the same three operands give different answers, which is what the
	// level cannot pick between on its own.
	if (a | b) & c != 0x02 or a | (b & c) != 0x03 {
		printf("(a | b) & c = 0x%02x, a | (b & c) = 0x%02x, expected 0x02/0x03\n",
			Word32((a | b) & c), Word32(a | (b & c)))
		return false
	}

	printf("passed: bitwise levels\n")
	return true
}


// `<<` and `>>` are on that same level and count as one kind, so they chain
// with each other but not with `&` `^` `|`.  Arithmetic shares the level
// too and is left out of the rule: `+` never meets a WordX, so a mixed
// chain there is a type error, and the type error is the more useful thing
// to say than a demand for parentheses that would not help.
func testShiftLevels () -> Bool {
	var w: Word8 = 0x03
	var x: Word8 = 0x40

	// Two shifts chain, from the left: (0x40 >> 1) >> 2 = 0x20 >> 2 = 0x08.
	// Right-associative it would be 0x40 >> (1 >> 2) = 0x40 >> 0 = 0x40.
	if x >> 1 >> 2 != 0x08 {
		printf("0x40 >> 1 >> 2 = 0x%02x, expected 0x08\n", Word32(x >> 1 >> 2))
		return false
	}

	// And in both directions: (0x03 << 2) << 1 = 0x18.
	if w << 2 << 1 != 0x18 {
		printf("0x03 << 2 << 1 = 0x%02x, expected 0x18\n", Word32(w << 2 << 1))
		return false
	}

	// `*` is tighter than the shift, so the count is the product:
	// w << (2 * 2) = 0x03 << 4 = 0x30.
	var two: Nat8 = 2
	if w << two * 2 != 0x30 {
		printf("0x03 << 2 * 2 = 0x%02x, expected 0x30\n", Word32(w << two * 2))
		return false
	}

	// And shifts before `==`, which is what lets a mask test be written
	// with no parentheses at all.
	if not (w << 3 == 0x18) {
		printf("`w << 3 == 0x18` did not group as (w << 3) == 0x18\n")
		return false
	}

	// Mixed with a bitwise operator the parentheses are required, and they
	// are what decides: the two readings of the same operands differ.
	var mask: Word8 = 0x06
	if (mask & w) << 2 != 0x08 or mask & (w << 2) != 0x04 {
		printf("(mask & w) << 2 = 0x%02x, mask & (w << 2) = 0x%02x, expected 0x08/0x04\n",
			Word32((mask & w) << 2), Word32(mask & (w << 2)))
		return false
	}

	printf("passed: shift levels\n")
	return true
}


// `or` is the loosest thing in an expression, then `and`, then equality.
func testLogicalLevels () -> Bool {
	var a: Int32 = 1
	var b: Int32 = 2

	// (a == 1) and (b == 2) — the operands of `and` are the comparisons,
	// not the values.
	if not (a == 1 and b == 2) {
		printf("`a == 1 and b == 2` is wrong for 1 and 2\n")
		return false
	}

	// `and` before `or`: false and false or true.
	if not (a == 9 and b == 9 or a == 1) {
		printf("`and` did not group tighter than `or`\n")
		return false
	}

	// A whole arithmetic-comparison-conjunction chain with no parentheses:
	// ((a + 1) == b) and ((b * 2) > (a + 1)).
	if not (a + 1 == b and b * 2 > a + 1) {
		printf("the unparenthesised chain over 1 and 2 is wrong\n")
		return false
	}

	printf("passed: logical levels\n")
	return true
}


// Below the binary operators: construction, then the unary operators, then
// the postfix ones — each tighter than the last.
func testUnaryAndConstruction () -> Bool {
	// Construction takes the value next to it, not the expression around
	// it: `Int32 small * 2` is (Int32 small) * 2.
	var small: Int8 = 3
	if Int32 small * 2 != 6 {
		printf("Int32 small * 2 = %d, expected 6\n", Int32 small * 2)
		return false
	}

	// Unary tighter than binary: (-a) + b, and (-a) * b.
	var a: Int32 = 5
	var b: Int32 = 3
	if -a + b != -2 or -a * b != -15 {
		printf("-a + b = %d, -a * b = %d, expected -2/-15\n", -a + b, -a * b)
		return false
	}

	// `not` is tighter than `==`, so this is (not t) == f.
	var t = true
	var f = false
	if not (not t == f) {
		printf("`not t == f` did not group as (not t) == f\n")
		return false
	}

	// `~` is tighter than `&`: (~mask) & w, not ~(mask & w).
	var w: Word32 = 0x0F
	var mask: Word32 = 0x03
	if ~mask & w != 0x0C {
		printf("~0x03 & 0x0F = 0x%x, expected 0x0C\n", ~mask & w)
		return false
	}

	// Postfix is tighter than everything: arr[1] + arr[2], and the index
	// expression is evaluated inside the brackets.
	var arr: [4]Int32 = [10, 20, 30, 40]
	var i: Int32 = 1
	if arr[1] + arr[2] != 50 or arr[i + 1] != 30 {
		printf("arr[1] + arr[2] = %d, arr[i + 1] = %d, expected 50/30\n",
			arr[1] + arr[2], arr[i + 1])
		return false
	}

	// A call binds tighter than the operator around it.
	if twice(a) + 1 != 11 or twice(a + 1) != 12 {
		printf("twice(a) + 1 = %d, twice(a + 1) = %d, expected 11/12\n",
			twice(a) + 1, twice(a + 1))
		return false
	}

	printf("passed: unary and construction\n")
	return true
}


func twice (n: Int32) -> Int32 {
	return n * 2
}


func main () -> Int {
	var result = true
	result = testArithmeticLevels() and result
	result = testBitwiseAgainstEquality() and result
	result = testBitwiseLevels() and result
	result = testShiftLevels() and result
	result = testLogicalLevels() and result
	result = testUnaryAndConstruction() and result

	if not result {
		printf("failed: precedence\n")
		return exitFailure
	}

	printf("passed: precedence\n")
	return exitSuccess
}
