// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-OUT: passed: half range edge
// EXPECT-OUT: passed: half overflow
// EXPECT-OUT: passed: Float16 range
//
// The edge of binary16, from below and from above.
//
// 65504 is the largest finite binary16, and everything up to it is an
// ordinary number.  Past it a literal no longer compiles at all — that is
// `overflow.modest`, next to this file.  What is left here is the other
// half of the same rule: how the hardware behaves right at the edge, and
// what happens when the range is left anyway, under `unsafe`, where the
// answer is IEEE 754's — infinity.

pragma unsafe

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


// Right up against the edge, everything is an ordinary finite number.
func testEdge () -> Bool {
	var max: Float16 = 65504.0
	var below: Float16 = 65472.0        // the next representable one down

	if not (below < max) {
		printf("65472 is not below 65504\n")
		return false
	}

	// Exactly halfway between the two rounds to even — and it is 65472
	// that has the even significand (0x7BFE), not the maximum.
	var halfway: Float16 = 65488.0
	if Float64 halfway != 65472.0 {
		printf("65488 = %f, expected it to round to 65472.0\n", Float64 halfway)
		return false
	}

	// A Float64 holds the same numbers as ordinary ones: the edge belongs
	// to the target width and not to the literal.
	var wide: Float64 = 70000.0
	if wide != 70000.0 {
		printf("Float64 70000.0 = %f, expected 70000.0\n", wide)
		return false
	}

	printf("passed: half range edge\n")
	return true
}


// Past the edge the compiler refuses the literal, so getting there at all
// takes `unsafe` — and then the answer is the one IEEE 754 gives.
func testOverflow () -> Bool {
	var max: Float16 = 65504.0

	// 65520 is the first value that rounds up rather than down — halfway
	// to the exponent that does not exist.
	var just = unsafe Float16 65520.0
	if not (Float64 just > 65504.0) {
		printf("65520 = %f, expected infinity\n", Float64 just)
		return false
	}

	var over = unsafe Float16 70000.0
	if not (over > max) {
		printf("70000 is not above the finite range\n")
		return false
	}

	// Infinite, not merely large: it absorbs everything finite.
	var one: Float16 = 1.0
	if Float64(over + one) != Float64 over {
		printf("70000 + 1 differs from 70000, expected infinity\n")
		return false
	}

	if Float64 over != Float64 just {
		printf("70000 and 65520 differ, expected both to be infinity\n")
		return false
	}

	printf("passed: half overflow\n")
	return true
}


func main () -> Int {
	var result = true
	result = testEdge() and result
	result = testOverflow() and result

	if not result {
		printf("failed: Float16 range\n")
		return exitFailure
	}

	printf("passed: Float16 range\n")
	return exitSuccess
}
