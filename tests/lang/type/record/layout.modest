// TEST: run
// BACKENDS: c11, llvm
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: exact is the target's own layout
// EXPECT-OUT: passed: packed adds no padding
// EXPECT-OUT: passed: union puts every field at zero
// EXPECT-OUT: passed: a layout does not reach into a field's own type
// EXPECT-OUT: passed: an annotation that cannot be honoured changes nothing
// EXPECT-OUT: passed: layout
//
// What `@layout` does to a record's numbers — the offsets, the size and the
// alignment — for each of its three values, asked of the same fields so that
// the three answers can be read against each other.  `packed.modest` and
// `union.modest` are about what those layouts are *for*; this is about
// getting them right.
//
// Both backends have to agree here, and they answer from opposite ends: on
// LLVM every number below comes from `calc_record_size_align` and is folded
// into the IR by the compiler, while on C every one of them is `sizeof` /
// `offsetof` / `__alignof` left for the C compiler, which reads them off
// the struct the backend emitted.  So the same expectation checks the
// frontend on one backend and the emission on the other, and a layout that
// is decided in one place but not carried to the other shows up as a
// disagreement rather than as nothing at all.
//
// Guards BUG#42 (fixed 2026-09-10).

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


// The same two fields three times over.  Word8 then Nat32 is the shape that
// tells the layouts apart: it is the one that needs padding.
type Exact = {
	tag: Word8
	len: Nat32
}

type Packed = @layout("packed") {
	tag: Word8
	len: Nat32
}

type Overlay = @layout("union") {
	word: Word32
	bytes: [4]Word8
	half: Word16
}

// A record with its own layout, sitting inside one with another.
type Frame = @layout("packed") {
	lead: Word8
	inner: Exact
	tail: Word8
}

// `@alignment` on a record is not honoured yet (BUG#71).  Not honoured has
// to mean left alone: the record must not come out *further* from what was
// asked than it started.
type Tight = @alignment(2) {
	a: Word8
}


func testExact () -> Bool {
	// The default, and the control for everything below: `Nat32` wants a
	// four-byte boundary, so three bytes go in front of it and one whole
	// word is the record's step.
	if offsetof(Exact.tag) != 0 or offsetof(Exact.len) != 4 {
		printf("Exact.tag at %zu, Exact.len at %zu, expected 0 and 4\n",
			offsetof(Exact.tag), offsetof(Exact.len))
		return false
	}

	if sizeof(Exact) != 8 or alignof(Exact) != 4 {
		printf("Exact is %zu bytes aligned %zu, expected 8 and 4\n",
			sizeof(Exact), alignof(Exact))
		return false
	}

	printf("passed: exact is the target's own layout\n")
	return true
}


func testPacked () -> Bool {
	// The same fields with the padding taken out: `len` starts where `tag`
	// ended, and a record that needs no boundary of its own is 1-aligned.
	if offsetof(Packed.tag) != 0 or offsetof(Packed.len) != 1 {
		printf("Packed.tag at %zu, Packed.len at %zu, expected 0 and 1\n",
			offsetof(Packed.tag), offsetof(Packed.len))
		return false
	}

	if sizeof(Packed) != 5 or alignof(Packed) != 1 {
		printf("Packed is %zu bytes aligned %zu, expected 5 and 1\n",
			sizeof(Packed), alignof(Packed))
		return false
	}

	printf("passed: packed adds no padding\n")
	return true
}


func testUnion () -> Bool {
	// Every field from zero, so the record is as long as its longest field
	// rather than as long as all of them.
	if offsetof(Overlay.word) != 0 or offsetof(Overlay.bytes) != 0 or offsetof(Overlay.half) != 0 {
		printf("Overlay at %zu, %zu, %zu, expected all zero\n",
			offsetof(Overlay.word), offsetof(Overlay.bytes),
			offsetof(Overlay.half))
		return false
	}

	// 4, not 4 + 4 + 2, and aligned for the widest member.
	if sizeof(Overlay) != 4 or alignof(Overlay) != 4 {
		printf("Overlay is %zu bytes aligned %zu, expected 4 and 4\n",
			sizeof(Overlay), alignof(Overlay))
		return false
	}

	printf("passed: union puts every field at zero\n")
	return true
}


func testNested () -> Bool {
	// A layout applies to the record that carries it and stops there: the
	// packed one puts `inner` at an odd offset, and `inner` is still the
	// padded eight-byte `Exact` it was declared as.
	if offsetof(Frame.lead) != 0 or offsetof(Frame.inner) != 1 or offsetof(Frame.tail) != 9 {
		printf("Frame at %zu, %zu, %zu, expected 0, 1 and 9\n",
			offsetof(Frame.lead), offsetof(Frame.inner), offsetof(Frame.tail))
		return false
	}

	if sizeof(Frame) != 10 or alignof(Frame) != 1 {
		printf("Frame is %zu bytes aligned %zu, expected 10 and 1\n",
			sizeof(Frame), alignof(Frame))
		return false
	}

	// The field's own type is untouched by the record it was used in.
	if sizeof(Exact) != 8 or offsetof(Exact.len) != 4 {
		printf("Exact is %zu bytes with len at %zu after Frame, expected 8 and 4\n",
			sizeof(Exact), offsetof(Exact.len))
		return false
	}

	printf("passed: a layout does not reach into a field's own type\n")
	return true
}


func testUnhonoured () -> Bool {
	// `@alignment(2)` is dropped on the way to both backends, so `Tight` is
	// the bare `Word8` it would have been without it.  What must never
	// happen is the annotation arriving without its 2 — a C attribute that
	// lost its argument does not mean "as written without it", it means the
	// widest alignment the target has, and the record would come back 16
	// bytes long.  Asked for 2, it may be 1 or 2, never more.
	if sizeof(Tight) > 2 or alignof(Tight) > 2 {
		printf("Tight is %zu bytes aligned %zu, asked for 2 (see BUG#71)\n",
			sizeof(Tight), alignof(Tight))
		return false
	}

	printf("passed: an annotation that cannot be honoured changes nothing\n")
	return true
}


func main () -> Int {
	var result = true
	result = testExact() and result
	result = testPacked() and result
	result = testUnion() and result
	result = testNested() and result
	result = testUnhonoured() and result

	if not result {
		printf("failed: layout\n")
		return exitFailure
	}

	printf("passed: layout\n")
	return exitSuccess
}
