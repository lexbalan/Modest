// TEST: run
// BACKENDS: c11, llvm
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: omitted record field
// EXPECT-OUT: passed: nested literal
// EXPECT-OUT: passed: nested record defaults
// EXPECTED-FAIL: BUGS.md#44 a nested record does not get its own defaults
//
// The defaults of a record type reached through a field of another record.
//
// A field takes "the default value of its type" when the literal omits it,
// and for a record type that value is `{}` of it — which is not all-zero
// storage: it is that type's own fields, each at *its* default.  Neither
// backend builds it that way, and they do not agree on how they get it
// wrong, so both halves of the page are here in one reproducer.
//
// `testOmittedField` is the field the outer literal never mentions: both
// backends zero it instead of constructing it.  `testNestedLiteral` is the
// field given a literal of its own, partially filled: LLVM completes it
// from `Inner`'s defaults (right), C11 zeroes what the literal left out.
//
// The rest of the defaults machinery works and is tested in
// `defaults.modest`; only the step through a record-typed field is broken.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


type Inner = {
	a: Int32 = 3
	b: Int32 = 4
}

// Neither field carries a default of its own — `in` has to fall back to
// the default value of `Inner`, which is `Inner {}` = {3, 4}.
type Outer = {
	tag: Int32
	in: Inner
}


func testOmittedField () -> Bool {
	// For reference: constructed on its own, Inner gets its defaults.
	var w: Inner = {}
	if w.a != 3 or w.b != 4 {
		printf("Inner {} = {%d, %d}, expected {3, 4}\n", w.a, w.b)
		return false
	}

	// The same value, reached as the default of a field.
	var x: Outer = {}
	if x.in.a != 3 or x.in.b != 4 {
		printf("Outer {}.in = {%d, %d}, expected {3, 4}\n", x.in.a, x.in.b)
		return false
	}

	// ... and when the literal fills the other field only.
	var y: Outer = {tag = 1}
	if y.in.a != 3 or y.in.b != 4 {
		printf("Outer {tag = 1}.in = {%d, %d}, expected {3, 4}\n", y.in.a, y.in.b)
		return false
	}

	printf("passed: omitted record field\n")
	return true
}


func testNestedLiteral () -> Bool {
	// The nested literal is a construction of Inner, so what it omits is
	// Inner's business: `b` is given, `a` falls back to 3.
	var z: Outer = {in = {b = 9}}
	if z.in.b != 9 {
		printf("z.in.b = %d, expected the literal's 9\n", z.in.b)
		return false
	}
	if z.in.a != 3 {
		printf("z.in.a = %d, expected Inner's default 3\n", z.in.a)
		return false
	}

	printf("passed: nested literal\n")
	return true
}


func main () -> Int {
	var result = true
	result = testOmittedField() and result
	result = testNestedLiteral() and result

	if not result {
		printf("failed: nested record defaults\n")
		return exitFailure
	}

	printf("passed: nested record defaults\n")
	return exitSuccess
}
